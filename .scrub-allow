# Accepted hits of scripts/scrub-check. One entry per line: <path glob>:<regex>
# The matching text is cut from lines of matching files before the check, so
# an entry allows exactly that text and nothing else on the line.
# Every entry has its reason above it. Keep the list short.

# Made-up tailnet addresses (100.64.0.x, the first block of the 100.64.0.0/10
# range a mesh VPN hands out) and a made-up tailnet name. The gateway admits
# only tailnet peers, so its tests and docs need addresses of that shape.
*:\b100\.64\.0\.[0-9]{1,3}\b
*:\bexample-tailnet\.ts\.net\b

# A psql variable that receives a SCRAM verifier at run time; no password is in the file.
db/bootstrap.sql:password :'verifier'
